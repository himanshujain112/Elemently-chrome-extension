{
  "manifest_version": 3,
  "name": "Elemently",
  "version": "1.0",
  "description": "Edit or remove unwanted elements from a webpage.",
  "permissions": [
    "activeTab"
  ],
  "icons": {
    "16": "/icons/icon16.png",
    "48": "/icons/icon48.png",
    "128": "/icons/icon128.png"
  },
  "action": {
    "default_icon": "/icons/icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}

